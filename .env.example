# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible LLM endpoint
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5
# Optional comma-separated text model fallback list, tried after LLM_MODEL
LLM_MODEL_FALLBACKS=
LLM_VISION_MODEL=mimo-v2.5

# Self-hosted SearXNG JSON endpoint, e.g. http://localhost:8080
# Run separately via: docker run --rm -p 8080:8080 -e SEARXNG_SECRET=$(openssl rand -hex 32) searxng/searxng
SEARXNG_URL=http://localhost:8080

# Optional: how many top results to fetch and extract (default 3)
SEARCH_TOP_N=3

# Optional: maximum answer-generation tool-call steps (default 150, max 300)
ANSWER_STEP_LIMIT=150
